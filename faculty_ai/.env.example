 --- Required ---
sk-ant-api03-wQ_...mAAA
# --- AI ---
CLAUDE_MODEL=claude-sonnet-5
FEEDBACK_LANGUAGE=English
# Send exam + model-answer files with every grading call (useful when questions rely on figures/diagrams).
# Uses prompt caching, but still costs more tokens.
ATTACH_EXAM_FILES=false
GRADING_MAX_TOKENS=16000
AI_MAX_ATTEMPTS=2

# --- Review rules ---
# Confidence below this value is only ONE of several review triggers (see README)
REVIEW_CONFIDENCE_THRESHOLD=0.75

# --- Runtime ---
GRADING_CONCURRENCY=3
MAX_UPLOAD_MB=30
# DATABASE_URL=sqlite:///data/faculty_ai.db
# DATA_DIR=./data
# API_URL=http://127.0.0.1:8000   # used by the Streamlit UI
# PDF_FONT_PATH=                  # TTF with Arabic glyphs for PDF export (auto-detected if empty)

# --- Security ---
# Long random string used to sign login sessions. REQUIRED in production (dev: auto-generated in data/.secret_key)
SECRET_KEY=
TOKEN_TTL_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Self-service registration & password reset ---
# Where the app runs, used to build the reset-password link sent by email
APP_BASE_URL=http://localhost:8501
PASSWORD_RESET_TTL_MINUTES=30
# Leave SMTP_HOST empty to run without a mail server: reset links are printed to the server
# console/log instead of emailed, so the flow still works end-to-end for local use/testing.
# Set these to send real emails (e.g. Gmail with an App Password, or any SMTP provider):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
